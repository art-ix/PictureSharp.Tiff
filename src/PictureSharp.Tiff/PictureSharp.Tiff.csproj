<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Tiff</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Tiff</PackageId>
    <Description>TIFF format plugin for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;tiff;tif;bigtiff;codec;decoder;encoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Tiff</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.6.0: reads more TIFF variants: integer samples of 1 to 16 and 32 bits (also signed), 16- and 64-bit floating point, CIE L*a*b* (as libtiff converts it), CMYK JPEG and planar JPEG; earlier files decode unchanged. Requires PictureSharp 0.7.10. Notes: https://github.com/art-ix/PictureSharp.Tiff/blob/v0.6.0/docs/releases/release-0.6.0.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
