<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Tiff</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Tiff</PackageId>
    <Description>TIFF format plugin for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;tiff;tif;codec;decoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Tiff</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0: the first release. Reads the first full-resolution page of TIFF and BigTIFF files: strips or tiles, none/PackBits/LZW/Deflate (predictors 2 and 3), JPEG and CCITT RLE/Group 3/Group 4; greyscale, palette, RGB, CMYK, YCbCr and 32-bit float with alpha; ICC, XMP, EXIF and orientation. Requires PictureSharp 0.7.8. Notes: https://github.com/art-ix/PictureSharp.Tiff/blob/v0.3.0/docs/releases/release-0.3.0.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
