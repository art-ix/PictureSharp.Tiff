<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Tiff</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Tiff</PackageId>
    <Description>TIFF format plugin for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;tiff;tif;bigtiff;codec;decoder;encoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Tiff</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.7.4: 16-bit images on PictureSharp 0.9.0: with DecoderOptions.PreserveBitDepth, samples of more than 8 bits decode to PixelType.Rgba64; 16-bit images are written with 16-bit grey or RGB samples (TiffEncoderOptions.BitDepth). 8-bit decoding and encoding are unchanged. Requires PictureSharp 0.9.0.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
