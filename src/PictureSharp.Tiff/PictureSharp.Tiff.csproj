<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Tiff</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Tiff</PackageId>
    <Description>TIFF format plugin for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;tiff;tif;bigtiff;codec;decoder;encoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Tiff</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.5.1: faster reading: strips and tiles decode in parallel (DecoderOptions.MaxDegreeOfParallelism), a single strip in parallel row bands, 8-bit fast paths and uncompressed data read in place; same pixels as 0.5.0 for every thread count. Requires PictureSharp 0.7.9. Notes: https://github.com/art-ix/PictureSharp.Tiff/blob/v0.5.1/docs/releases/release-0.5.1.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
